# ---- App ----
ONCALL_ENV=dev
ONCALL_LOG_LEVEL=INFO
ONCALL_API_PREFIX=/api
ONCALL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Postgres ----
ONCALL_DATABASE_URL=postgresql+asyncpg://oncall:oncall@127.0.0.1:5432/oncall
# postgres | memory（memory 仅测试/无库演示，重启即丢数据；生产不要用）
ONCALL_STORE_BACKEND=postgres

# ---- Redis ----
ONCALL_REDIS_URL=redis://127.0.0.1:6379/0

# ---- Model gateway ----
# OpenAI 兼容协议；本地 Ollama 用 http://127.0.0.1:11434/v1，key 随便填
ONCALL_MODEL_PROVIDERS=cloud,local
ONCALL_CLOUD_BASE_URL=https://api.example.com/v1
ONCALL_CLOUD_API_KEY=
ONCALL_CLOUD_MODEL=
ONCALL_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
ONCALL_LOCAL_API_KEY=ollama
ONCALL_LOCAL_MODEL=qwen2.5:7b

# ---- Mock 模式：不填任何模型 key 也能演示完整链路 ----
ONCALL_MOCK_MODE=true

# 容器首次启动是否灌演示数据（演示 true；生产必须 false，避免 seed 语料回灌）
ONCALL_SEED_DEMO=true

# ---- RAG（W2）----
# auto：store 用 postgres 时走 pgvector，否则内存；memory 仅演示/测试
ONCALL_RAG_BACKEND=auto
ONCALL_RAG_TOP_K=5
ONCALL_RAG_CANDIDATES=20
ONCALL_RAG_MIN_SCORE=0.38
# RRF 融合常数：越小越偏向单路排名，60 是论文默认值
ONCALL_RAG_RRF_K=60
# hashing：确定性哈希向量（无模型依赖，可复现）；http：OpenAI 兼容 /embeddings
ONCALL_EMBEDDING_PROVIDER=hashing
ONCALL_EMBEDDING_DIM=1024
# 切到 http 时生效，例如 Ollama bge-m3：http://127.0.0.1:11434/v1
ONCALL_EMBEDDING_BASE_URL=
ONCALL_EMBEDDING_API_KEY=
ONCALL_EMBEDDING_MODEL=bge-m3
ONCALL_KB_MAX_UPLOAD_MB=10
ONCALL_ADMIN_ROLES=admin

# ---- 审批（W3）----
# 能审批写操作的角色（逗号分隔）；审批人不能审批自己发起的操作
ONCALL_APPROVER_ROLES=approver
# 审批卡有效期；超时置 expired，run 转 failed(APPROVAL_TIMEOUT)
ONCALL_APPROVAL_TTL_MIN=10
# scope=session 的授权有效期
ONCALL_APPROVAL_GRANT_HOURS=8

# ---- 预算与限流 ----
ONCALL_DAILY_BUDGET_CNY=5.0
# 每用户日预算（元；0 = 不限制）。管理页可按用户覆盖，见 ADR-0026
ONCALL_USER_DAILY_BUDGET_CNY=0
ONCALL_RATE_LIMIT_PER_MIN=30

# ---- 运行态 ----
# JWT 签名密钥：本地开发用默认值，生产必须改（python -c "import secrets;print(secrets.token_urlsafe(48))"）
ONCALL_SESSION_SECRET=dev-change-me
# 事件（回放与审计）保留天数：过期后整场 run 的事件被清理，run 摘要保留
ONCALL_EVENT_RETENTION_DAYS=180
# 模型调用计量保留天数（成本看板数据源；过期后 runs 上的汇总仍保留）
ONCALL_MODEL_CALL_RETENTION_DAYS=180
# 保留清理：扫描间隔（秒）、单批行数、每轮最多几批（取不满一批即停）
ONCALL_RETENTION_INTERVAL_S=21600
ONCALL_RETENTION_BATCH=200
ONCALL_RETENTION_MAX_BATCHES=10
# 已移除会话恢复审计保留天数（ADR-0059）：独立于事件/正文/计量保留期
ONCALL_SESSION_RESTORE_AUDIT_RETENTION_DAYS=365
# 超过该时长没有任何事件的 running run 判定为进程中断（须远大于 run 时长上限 120s）
ONCALL_STALE_RUN_MIN=10
# 孤儿 run 回收任务扫描间隔（秒）
ONCALL_RECOVERY_INTERVAL_S=60
